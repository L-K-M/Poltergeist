# Dart / Pub
.dart_tool/
.packages
build/

# scripts/build.sh stages final artifacts here
dist/
.pub-cache/
.pub/
pubspec_overrides.yaml

# The bench job's per-scenario documents and merged output land at the
# repo root (CI uploads them as artifacts; locally they are run output).
/bench-results*.json
/bench-drift-state.json
/evaluate.log
/.bench-results-*.json.saved
packages/poltergeist_bench/bench-results.json
packages/poltergeist_bench/bench-shard.json
packages/poltergeist_bench/bench-results.json.attempts.json
packages/poltergeist_bench/shards/
packages/poltergeist_bench/evidence/

# Generated SFTP integration payloads and ephemeral user credentials.
test/integration/runtime/

# Flutter (app lives at app/poltergeist_app once scaffolded)
app/poltergeist_app/.flutter-plugins
app/poltergeist_app/.flutter-plugins-dependencies
app/poltergeist_app/.dart_tool/
app/poltergeist_app/build/
app/poltergeist_app/ios/Pods/
app/poltergeist_app/android/.gradle/
app/poltergeist_app/**/GeneratedPluginRegistrant.*

# Local build byproducts the platform folders' own ignores miss: the Kotlin
# Gradle plugin's session and error logs, and Xcode's pins for plugins'
# remote Swift packages (iOS file_picker's DKImagePickerController), which
# every build re-resolves from the plugins' Package.swift.
app/poltergeist_app/android/.kotlin/
app/poltergeist_app/*/Runner.xcworkspace/xcshareddata/swiftpm/Package.resolved

# `dart test --coverage` / `flutter test --coverage` output, and the Flutter
# tool's crash logs, which land in whatever directory it ran from.
coverage/
flutter_*.log

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
