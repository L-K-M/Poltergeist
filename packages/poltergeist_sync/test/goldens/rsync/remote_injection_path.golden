# note: uses your OpenSSH config and known_hosts, not Poltergeist's connections
# note: RSYNC_OLD_ARGS=2 RSYNC_PROTECT_ARGS=0 keep rsync from escaping the remote path a second time; it is already escaped here for the remote shell, and versions without these variables ignore them
# note: rsync is single-stream
# Preview first (matches Poltergeist's plan):  RSYNC_OLD_ARGS=2 RSYNC_PROTECT_ARGS=0 rsync -n -i -r -p -t --modify-window=2 --backup --backup-dir='.poltergeist-trash/rsync-20260922-150407' -e 'ssh' --exclude='*.poltergeist-*' --exclude='.poltergeist*' --exclude='desktop.ini' --exclude='Thumbs.db' --exclude='.DS_Store' -- '/home/me/site/' 'deploy@example.com:/var/www/a\;\$\(rm\ -rf\ b\)\|tee'
RSYNC_OLD_ARGS=2 RSYNC_PROTECT_ARGS=0 rsync -r -p -t --modify-window=2 --backup --backup-dir='.poltergeist-trash/rsync-20260922-150407' -e 'ssh' --exclude='*.poltergeist-*' --exclude='.poltergeist*' --exclude='desktop.ini' --exclude='Thumbs.db' --exclude='.DS_Store' -- '/home/me/site/' 'deploy@example.com:/var/www/a\;\$\(rm\ -rf\ b\)\|tee'
