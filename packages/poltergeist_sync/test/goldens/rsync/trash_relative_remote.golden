# note: uses your OpenSSH config and known_hosts, not Poltergeist's connections
# note: RSYNC_OLD_ARGS=2 RSYNC_PROTECT_ARGS=0 keep rsync from escaping the remote path a second time; it is already escaped here for the remote shell, and versions without these variables ignore them
# note: the trash exclude '/my trash/dir' also filters the source side — files under the same relative path in the source are not copied
# note: --delete-delay approximates the plan's delete-after-clean-copy gate — on a partial failure that is not an I/O error rsync may still delete where the executor would not
# note: --max-delete=500 caps deletions per run — rsync performs up to the cap and stops with an error, where the plan refuses to start at all
# note: rsync is single-stream
# Preview first (matches Poltergeist's plan):  RSYNC_OLD_ARGS=2 RSYNC_PROTECT_ARGS=0 rsync -n -i -r -p -t --modify-window=2 --delete-delay --max-delete=500 --backup --backup-dir='my\ trash/dir' -e 'ssh' --exclude='/my trash/dir' --exclude='*.poltergeist-*' --exclude='.poltergeist*' --exclude='desktop.ini' --exclude='Thumbs.db' --exclude='.DS_Store' -- '/home/me/site/' 'deploy@example.com:/var/www/site'
RSYNC_OLD_ARGS=2 RSYNC_PROTECT_ARGS=0 rsync -r -p -t --modify-window=2 --delete-delay --max-delete=500 --backup --backup-dir='my\ trash/dir' -e 'ssh' --exclude='/my trash/dir' --exclude='*.poltergeist-*' --exclude='.poltergeist*' --exclude='desktop.ini' --exclude='Thumbs.db' --exclude='.DS_Store' -- '/home/me/site/' 'deploy@example.com:/var/www/site'
