# note: uses your OpenSSH config and known_hosts, not Poltergeist's connections
# note: this pair connects through a jump host — the command below connects directly and will not traverse it
# note: rsync is single-stream
# Preview first (matches Poltergeist's plan):  rsync -n -i -r -p -t --modify-window=2 --backup --backup-dir='.poltergeist-trash/rsync-20260922-150407' -e 'ssh' --exclude='\*.poltergeist-\*' --exclude='.poltergeist\*' --exclude='desktop.ini' --exclude='Thumbs.db' --exclude='.DS_Store' -- '/home/me/site/' 'deploy@example.com:/var/www/site'
rsync -r -p -t --modify-window=2 --backup --backup-dir='.poltergeist-trash/rsync-20260922-150407' -e 'ssh' --exclude='\*.poltergeist-\*' --exclude='.poltergeist\*' --exclude='desktop.ini' --exclude='Thumbs.db' --exclude='.DS_Store' -- '/home/me/site/' 'deploy@example.com:/var/www/site'
